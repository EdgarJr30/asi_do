{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/lib/permissions/guards.ts",
    "tests/e2e/support/target-guard.ts"
  ],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": true
  },
  "reporters": [
    "clear-text",
    "html",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 100
  },
  "timeoutMS": 10000,
  "concurrency": 2
}
