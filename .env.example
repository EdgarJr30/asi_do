# Copia este archivo a `.env.local` y rellena los valores reales (no se versiona).
# En local no definas URLs de Auth: se usa el origin real del navegador.
# Staging/produccion las reciben del entorno de despliegue, nunca del repo.

# --- App / Supabase (cliente, expuestas al browser con prefijo VITE_) ---
VITE_APP_NAME=asi_do
VITE_SUPABASE_URL=
# Llave publicable del proyecto (formato sb_publishable_...). Sustituye a la
# antigua anon key JWT, retirada tras la migracion de llaves de 2026-08-02.
VITE_SUPABASE_ANON_KEY=
VITE_WEB_PUSH_PUBLIC_KEY=

# Solo para builds desplegados. VITE_DEPLOY_ENV lo aporta .env.staging o
# .env.production; estas dos URLs las inyecta el proveedor de despliegue.
VITE_AUTH_SITE_URL=
VITE_PRODUCTION_SITE_URL=

# URL pública del microservicio de pagos AZUL (services/azul-payments, desplegado en Railway/Render)
VITE_AZUL_PAYMENTS_URL=

# --- Correo (Resend) ---
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROCESSOR_SECRET=

# --- Servidor / scripts (NUNCA prefijar con VITE_; no exponer al browser) ---
# Llave secreta del proyecto (formato sb_secret_...). Omite RLS: solo en
# procesos de servidor, jamas en el browser. Sustituye a la service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests E2E (Playwright) ---
E2E_BASE_URL=http://127.0.0.1:4173
# Obligatorio para cualquier suite que escriba en un Supabase remoto.
# Solo acepta development o staging; production aborta antes de crear el cliente.
E2E_TARGET_ENV=development
E2E_SUPABASE_URL=
E2E_SERVICE_ROLE_KEY=
# Project ref productivo (no es secreto). Cuando exista, añade una negación
# explícita encima de la allow-list segura versionada en target-guard.ts.
PRODUCTION_SUPABASE_PROJECT_REF=
